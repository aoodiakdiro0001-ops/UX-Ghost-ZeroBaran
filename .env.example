# =====================================================================
#  UX-Ghost ZeroBaran — Environment variables template
#  Copy to .env and fill in your real values.  Never commit .env.
#  Author: Baran Avisat
# =====================================================================

# ----- Supabase (Free Tier — https://supabase.com) -----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_KEY=eyJhbGciOi...     # service_role — keep SECRET

# ----- AI provider (pick one) -----
UXG_AI_PROVIDER=gemini                  # gemini | groq
GEMINI_API_KEY=AIza...
GROQ_API_KEY=gsk_...

# ----- Telegram Bot (https://t.me/BotFather) -----
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=-1001234567890         # your private channel/chat id

# ----- Tunable behaviour thresholds -----
UXG_RAGE_THRESHOLD=5                    # rage clicks in window
UXG_RAGE_VISITOR_MIN=3                  # min distinct visitors
UXG_FUNNEL_DROP_ALERT=40                # % drop to alert
UXG_WINDOW_MIN=30                       # realtime window (minutes)

# ----- Logging -----
UXG_LOG_LEVEL=INFO
